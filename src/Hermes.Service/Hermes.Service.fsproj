<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>FS3511</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hermes.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Lifetime.fs" />
    <Compile Include="LocalBoundary.fs" />
    <Compile Include="HttpAccessPolicy.fs" />
    <Compile Include="HttpRequestLifetime.fs" />
    <Compile Include="LocalAccessHttp.fs" />
    <Compile Include="OwnerAccessAdapter.fs" />
    <Compile Include="ServicePolicy.fs" />
    <Compile Include="CanonicalUi.fs" />
    <Compile Include="ServiceAccessHost.fs" />
    <Compile Include="PersistedApi.fs" />
    <Compile Include="KeywordApi.fs" />
    <Compile Include="ReindexCommand.fs" />
    <Compile Include="ReindexOutput.fs" />
    <Compile Include="ReindexOperator.fs" />
    <Compile Include="OwnerUiCommand.fs" />
    <Compile Include="ServiceEntry.fs" />
    <Compile Include="ApiServer.fs" />
    <Compile Include="SleepGuard.fs" />
    <Compile Include="StartupAdmission.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hermes.Core\Hermes.Core.fsproj" />
    <ProjectReference Include="..\Hermes.Servicing\Hermes.Servicing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy gmail_credentials.json to output if present (app-level OAuth client ID) -->
    <None Include="credentials\gmail_credentials.json" Condition="Exists('credentials\gmail_credentials.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>credentials\gmail_credentials.json</Link>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <CanonicalUiDist>$(MSBuildProjectDirectory)/../Hermes.Web/dist</CanonicalUiDist>
  </PropertyGroup>

  <ItemGroup>
    <!-- The checked legacy bundle is never a build or publish input. -->
    <Content Remove="wwwroot/**" />
    <None Remove="wwwroot/**" />
  </ItemGroup>

  <Target Name="PrepareCanonicalUi"
          BeforeTargets="PrepareForBuild;ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(CanonicalUiDist)/index.html') Or !Exists('$(CanonicalUiDist)/asset-manifest.json')"
           Text="Canonical React bundle is missing. Run npm ci --prefix src/Hermes.Web and npm run build --prefix src/Hermes.Web before dotnet build/publish. Expected Hermes.Web/dist/index.html and asset-manifest.json; legacy Service/wwwroot is not used." />
    <ItemGroup>
      <_CanonicalUiFile Remove="@(_CanonicalUiFile)" />
      <_CanonicalUiFile Include="$(CanonicalUiDist)/**/*"
                        Exclude="$(CanonicalUiDist)/node_modules/**;$(CanonicalUiDist)/**/node_modules/**" />
    </ItemGroup>
  </Target>

  <Target Name="CopyCanonicalUiToOutput"
          AfterTargets="Build"
          DependsOnTargets="PrepareCanonicalUi"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(TargetDir)wwwroot" />
    <Copy SourceFiles="@(_CanonicalUiFile)"
          DestinationFiles="@(_CanonicalUiFile->'$(TargetDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ItemGroup>
      <FileWrites Include="@(_CanonicalUiFile->'$(TargetDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeCanonicalUiInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="PrepareCanonicalUi"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(PublishDir)/wwwroot" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_CanonicalUiFile)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
